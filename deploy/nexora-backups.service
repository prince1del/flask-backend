[Unit]
Description=NEXORA per-firm locked backups on the server (only when data changed)
After=network-online.target nexora.service

[Service]
Type=oneshot
User=nexora
Group=nexora
WorkingDirectory=/opt/nexora
EnvironmentFile=/etc/nexora.env
Environment=PYTHONPATH=/opt/nexora
ExecStart=/opt/nexora/.venv/bin/python -m app.hop_server_backups
