# NEXORA server settings. Lives at /etc/nexora.env on the server (NOT in git).
# setup_server.sh fills SECRET_KEY / JWT_SECRET_KEY / passwords / DATABASE_URL automatically.
# Fill the API keys by hand.

# --- Core ---
PORT=10000
DATABASE_URL=
PERSISTENT_DISK_PATH=/var/data
SECRET_KEY=
JWT_SECRET_KEY=
# Keeps the same low-RAM OCR behaviour the app had on Render.
RENDER=true

# --- First admin logins (created on first boot; change after login) ---
SEED_USERNAME=kps.julka@gmail.com
SEED_PASSWORD=
HOP_ADMIN_USERNAME=prince1del
HOP_ADMIN_PASSWORD=

# --- AI / OCR ---
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=

# --- Google login / Drive ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_DOMAIN/api/v1/storage/oauth-callback

# --- Gmail (Mail Sync) ---
GOOGLE_GMAIL_OAUTH_REDIRECT_URI=https://YOUR_DOMAIN/api/v1/mail-sync/oauth-callback

# --- Optional ---
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# GSTIN_LOOKUP_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# GUNICORN_WORKERS=1
# GUNICORN_THREADS=6
