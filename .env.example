FIREBASE_PROJECT_ID=your-project-id
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
FIREBASE_CREDENTIALS_JSON=C:/path/to/serviceAccount.json
CLOUD_DATABASE_URL=sqlite:///centralized_db.sqlite3
AUTH_ENABLED=false
SECRET_KEY=change-me
# Ask NEXORA — Gemini suggest (free key: https://aistudio.google.com/apikey)
# Also used by: visiting-card OCR, HoP handwriting OCR, DSR polish-notes (?polish=1 on export)
GEMINI_API_KEY=
# Optional: pin OCR model globally (single source used by both card-reader engines)
# GEMINI_FLASH_MODEL=gemini-3.5-flash
# Optional advanced override (comma-separated fallback list):
# GEMINI_OCR_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-2.0-flash
# Optional: only used when rule engine returns help (not on every Ask).
# Leave off for fastest replies; set 1 to enable Gemini rewrite fallback.
NEXORA_ASK_LLM=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
# HoP Vendor Compare — handwriting OCR (best-first)
# 1) GEMINI_API_KEY — Gemini Vision (best for messy handwriting; already used by Ask NEXORA)
# 2) Optional Azure Document Intelligence Read model:
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Local fallbacks (no key): EasyOCR, PaddleOCR, RapidOCR, optional Tesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
